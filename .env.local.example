# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Optional: domain for the hidden per-user auth emails (no mail is ever sent). Never change it after users exist.
# AUTH_EMAIL_DOMAIN=users.business-assistant.invalid

# Encrypts OpenAI keys saved in Admin → AI. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEY_ENCRYPTION_KEY=

# Optional platform (vendor) OpenAI key, used when a business hasn't added its own.
# OPENAI_API_KEY=sk-...
# Optional model overrides.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# OPENAI_AGENT_MODEL=gpt-5.4-mini
